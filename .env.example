# ── Required in production ────────────────────────────────────────────────
# Postgres connection. Leave unset locally to use the built-in PGlite database (.data/pglite).
DATABASE_URL=
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Public URL of the app, used in Stripe redirects, emails and calendar links.
APP_URL=https://10is.app

# ── AI string recommendations + Club chat ─────────────────────────────────
# Either the Replit-style integration vars or a plain OpenAI key works.
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Payments (use sk_test_… keys outside production) ──────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Stringer search (Google Places Text Search API) ───────────────────────
GOOGLE_MAPS_API_KEY=

# ── Restring reminder emails (optional) ───────────────────────────────────
# Without RESEND_API_KEY, reminders still show in the app and as calendar files.
RESEND_API_KEY=
REMINDER_FROM_EMAIL=10IS <reminders@10is.app>
# Lets an external cron call POST /api/cron/reminders (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────
ADMIN_EMAIL=contact@hevini.com
# Only used if the admin account has no password set yet.
ADMIN_PASSWORD=
