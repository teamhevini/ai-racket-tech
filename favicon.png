@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-body: 'Inter', Helvetica, Arial, sans-serif;
  --font-display: 'Inter', Helvetica, Arial, sans-serif;

  /* 10IS — Hevini Brand Palette */
  --background: 0 0% 4%;            /* Court Black #0A0A0A */
  --foreground: 0 0% 100%;          /* Court White */

  --card: 0 0% 7%;                  /* Slightly lifted black */
  --card-foreground: 0 0% 100%;

  --popover: 0 0% 7%;
  --popover-foreground: 0 0% 100%;

  --primary: 350 87% 41%;           /* Hevini Red #C8102E */
  --primary-foreground: 0 0% 100%;

  /* Semantic 'secondary' is a subtle dark surface — use the .bg-chalk utility for explicit Chalk areas */
  --secondary: 0 0% 10%;            /* #1A1A1A */
  --secondary-foreground: 0 0% 100%;

  --muted: 0 0% 12%;                /* Dark surface */
  --muted-foreground: 0 0% 55%;     /* Net Grey #8C8C8C */

  --accent: 350 87% 41%;            /* Hevini Red */
  --accent-foreground: 0 0% 100%;

  --destructive: 350 87% 41%;
  --destructive-foreground: 0 0% 100%;

  --border: 0 0% 12%;               /* Subtle dark border */
  --input: 0 0% 12%;
  --ring: 350 87% 41%;

  --radius: 0.125rem;               /* 2px — tight, sporty */
}

@layer base {
  * {
    @apply border-border;
  }
  html, body {
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
  }
  body {
    @apply antialiased selection:bg-primary/40 selection:text-white;
    font-family: var(--font-body);
  }
  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    @apply font-bold tracking-tight text-foreground;
  }
  /* Hard-edge inputs to match brand */
  input, textarea, select {
    @apply bg-muted border-border text-foreground;
  }
}

/* Brand utilities */
.text-court-white { color: #FFFFFF; }
.text-net-grey   { color: #8C8C8C; }
.text-hevini-red { color: #C8102E; }
.bg-court-black  { background-color: #0A0A0A; }
.bg-chalk        { background-color: #F5F3EF; }
.bg-hevini-red   { background-color: #C8102E; }

/* Uppercase brand label */
.brand-label {
  font-family: var(--font-display);
  font-weight: 700;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.animate-in {
  animation: fadeIn 0.5s ease-out forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to   { opacity: 1; transform: translateY(0); }
}
